<!-- Begin Header -->
<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a href="index.html"><img src="images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
@{
                var dsLoai = ViewBag.LoaiTaiSans as IEnumerable<TranVietHung_241230741.Models.LoaiTaiSan>;
}
            <ul class="menu">
                <li class="active"><a href="javascript:void(0)" class="nav-asset-link" data-ma-loai="0" data-ten-loai="NGUYỄN VĂN AN"></a>
                </li>
                @if (dsLoai != null)
                {
                    foreach (var loai in dsLoai)
                    {
                        <li><a href="javascript:void(0)" class="nav-asset-link" data-ma-loai="@loai.MaLoai" data-ten-loai="@loai.TenLoai.ToUpper()">@loai.TenLoai.ToUpper()</a></li>
                    }
                }
            </ul>
            <form class="search-box" onsubmit="return false;">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>
<!-- End Header -->